{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "src/**",
      "test/**",
      "migrations/**",
      "package.json",
      "package-lock.json",
      "tsconfig.json",
      "Dockerfile",
      "railway.json"
    ]
  },
  "deploy": {
    "preDeployCommand": ["npm run migrate"],
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
